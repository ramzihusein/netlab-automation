{# IOS wants a network + wildcard mask instead of a prefix length #}
- afi: ipv4
  acls:
{% for acl in netbox_policy.acls %}
    - name: {{ acl.name }}
      acl_type: extended
      aces:
{% for entry in acl.entries %}
        - sequence: {{ entry.seq }}
          grant: {{ entry.action }}
          protocol: {{ entry.protocol }}
          source:
{% if entry.src == 'any' %}
            any: true
{% else %}
            address: {{ entry.src | ansible.utils.ipaddr('network') }}
            wildcard_bits: {{ entry.src | ansible.utils.ipaddr('hostmask') }}
{% endif %}
          destination:
{% if entry.dst == 'any' %}
            any: true
{% else %}
            address: {{ entry.dst | ansible.utils.ipaddr('network') }}
            wildcard_bits: {{ entry.dst | ansible.utils.ipaddr('hostmask') }}
{% endif %}
{% if entry.dst_port is defined %}
            port_protocol:
              eq: "{{ entry.dst_port }}"
{% endif %}
{% if entry.log | default(false) %}
          log:
            set: true
{% endif %}
{% endfor %}
{% endfor %}
