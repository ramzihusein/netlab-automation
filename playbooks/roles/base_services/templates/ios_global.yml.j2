{# Global settings, written the way IOS-XE shows them in running-config #}
- hostname {{ inventory_hostname }}
- lldp run
{% if netbox_policy.domain_name is defined %}
- ip domain name {{ netbox_policy.domain_name }}
{% endif %}
{% for server in netbox_policy.name_servers | default([]) %}
- ip name-server {{ ('vrf ' ~ mgmt_vrf ~ ' ') if mgmt_vrf is defined else '' }}{{ server }}
{% endfor %}
{% if netbox_policy.snmp_ro_community is defined %}
- snmp-server community {{ netbox_policy.snmp_ro_community }} RO
{% endif %}
{# Lets AAP copy a backed-up config onto the device over SCP
   (NetLab - Restore Configs); the IOS SCP server needs AAA authorization #}
- aaa new-model
- aaa authentication login default local
- aaa authorization exec default local
- ip scp server enable
