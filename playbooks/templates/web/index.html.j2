<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ inventory_hostname }} — v{{ app_version }}</title>
  <style>
    body { margin: 0; font-family: system-ui, sans-serif; background: {{ app_colors[app_color] }}; color: #fff;
           min-height: 100vh; display: grid; place-items: center; }
    main { text-align: center; padding: 2rem; }
    h1 { font-size: 3rem; margin: 0 0 .5rem; }
    p { font-size: 1.25rem; margin: .25rem 0; }
    table { margin: 2rem auto 0; border-collapse: collapse; font-size: 1rem; text-align: left; }
    td { padding: .3rem 1rem; border-top: 1px solid rgba(255,255,255,.3); }
  </style>
</head>
<body>
  <main>
    <h1>{{ app_message }}</h1>
    <p>Release v{{ app_version }}</p>
    <table>
      <tr><td>Server</td><td>{{ inventory_hostname }}</td></tr>
      <tr><td>OS</td><td>{{ ansible_distribution }} {{ ansible_distribution_version }}</td></tr>
      <tr><td>Deployed</td><td>{{ now(utc=true, fmt='%Y-%m-%d %H:%M UTC') }}</td></tr>
      <tr><td>By</td><td>Ansible Automation Platform, job {{ awx_job_id | default('manual') }}</td></tr>
    </table>
  </main>
</body>
</html>
